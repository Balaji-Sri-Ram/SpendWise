# Database Configuration (PostgreSQL / Neon)
DB_URL=jdbc:postgresql://your-host:5432/your-database?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length_for_hs256
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Server Configuration (Optional - defaults to 8081)
PORT=8081

# CORS Allowed Origins (Optional - comma-separated list, defaults to localhost:5173,localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
